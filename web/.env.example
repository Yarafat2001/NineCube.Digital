# Frontend configuration. Copy to web/.env.local to override, and restart the dev server.
#
# There are no secrets here and there must never be: everything prefixed with VITE_ is inlined into
# the browser bundle. The API credentials live in the root .env, which is read by the .NET API only.
#
# Defaults to http://localhost:5080 when unset (see src/api/client.ts).
VITE_API_BASE_URL=http://localhost:5080
