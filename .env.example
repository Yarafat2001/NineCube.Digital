# ---------------------------------------------------------------------------
# NineCube.Digital - Order Processing
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# No real credential is ever committed to this repository.
# ---------------------------------------------------------------------------

# --- SQL Server (used by docker compose) -----------------------------------
# Must satisfy SQL Server complexity rules: at least 8 characters using at least
# three of uppercase, lowercase, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe_Strong!Passw0rd
# Host port the container publishes 1433 on. 14330 avoids clashing with a local instance.
MSSQL_HOST_PORT=14330

# --- API (.NET) ------------------------------------------------------------
# ASP.NET Core reads these with the double-underscore hierarchy separator.
# NOTE: if the password contains a semicolon, prefer building the connection string
# in appsettings.Development.json / user secrets instead of an env var.
ConnectionStrings__Default=Server=localhost,14330;Database=NineCubeOrderProcessing;User Id=sa;Password=ChangeMe_Strong!Passw0rd;TrustServerCertificate=True;Encrypt=False
# HS256 signing key: at least 32 bytes, random. Generate with e.g.
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-me-with-at-least-32-random-characters
Jwt__SigningKey=replace-me-with-at-least-32-random-characters

# --- Frontend (Vite) -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5080

# --- Demo seed accounts (Development only) ---------------------------------
# A single fallback password for all four demo accounts...
NINECUBE_SEED_PASSWORD=ChangeMe_Strong!Passw0rd
# ...or set them individually (any that are empty fall back to the value above).
NINECUBE_SEED_CUSTOMER_PASSWORD=
NINECUBE_SEED_STAFF_PASSWORD=
NINECUBE_SEED_INVENTORY_PASSWORD=
NINECUBE_SEED_ADMIN_PASSWORD=

# --- Tests -----------------------------------------------------------------
# Optional. When set, the integration tests skip Testcontainers and run against
# this connection string (a real SQL Server / Express / LocalDB instance).
# A uniquely named database is created per run and dropped afterwards.
# TEST_SQL_CONNECTION=Server=(localdb)\MSSQLLocalDB;Integrated Security=true;TrustServerCertificate=True
